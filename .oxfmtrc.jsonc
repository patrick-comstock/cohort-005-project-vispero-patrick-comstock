{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  // Leave package.json key order as it is (oxfmt sorts it by default).
  "sortPackageJson": false,
  // oxfmt also reads .gitignore. These are tracked or generated files
  // that it must leave alone.
  "ignorePatterns": [
    // Build output and generated types
    "build/",
    ".react-router/",
    "node_modules/",
    "coverage/",
    // Generated by drizzle-kit
    "drizzle/",
    // Lockfiles
    "package-lock.json",
    "skills-lock.json",
    // Agent skills, some installed from upstream and pinned by hash in
    // skills-lock.json. Reformatting would break the hashes.
    ".agents/",
    ".claude/",
  ],
}
