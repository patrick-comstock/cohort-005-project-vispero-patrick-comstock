// Lint only the mechanical rules in CODING_STANDARDS.md. Judgement calls stay
// with the reviewer; whole presets and categories are deliberately not enabled.
//
// Every rule is switched on in an override scoped to app/, scripts/ or
// request-logger/; files elsewhere (vite.config.ts and the like) get no rules.
// Overrides apply in order and a later override replaces a rule's options
// rather than merging them, so each rule's options live in exactly one place.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  // Rules oxlint has no native version of. local/no-restricted-syntax is
  // ESLint's core no-restricted-syntax (esquery selectors); see the plugin.
  "jsPlugins": ["eslint-plugin-simple-import-sort", "./oxlint-local-plugin.js"],
  "categories": { "correctness": "off" },
  "options": { "reportUnusedDisableDirectives": "error" },
  "ignorePatterns": [
    "build/**",
    "node_modules/**",
    ".react-router/**",
    "drizzle/**",
    "**/+types/**"
  ],
  "overrides": [
    {
      "files": [
        "app/**/*.{ts,tsx}",
        "scripts/**/*.{ts,tsx}",
        "request-logger/**/*.{ts,tsx}"
      ],
      "rules": {
        // "Do not write `any`, and do not write `!`"
        "typescript/no-non-null-assertion": "error",
        "typescript/no-explicit-any": "error",
        // New selector checks go in this one array: a second
        // local/no-restricted-syntax entry in a later override would replace
        // these selectors, not add to them.
        "local/no-restricted-syntax": [
          "error",
          // "Fail with a thrown response, not a return value"
          {
            "selector": ":matches(FunctionDeclaration[id.name=/^(loader|action)$/], VariableDeclarator[id.name=/^(loader|action)$/]) ReturnStatement Property[key.name=\"ok\"]:matches([value.value=false], [value.expression.value=false])",
            "message": "Loaders and actions throw on failure (e.g. throw data(\"Not found\", { status: 404 })). A refusal the user can fix in the form is returned as data({ error }, { status: 400 }). See CODING_STANDARDS.md."
          },
          // "Parse untrusted input with a schema"
          {
            "selector": "TSAsExpression[typeAnnotation.type='TSStringKeyword'] > CallExpression[callee.property.name='get'][callee.object.name=/^(formData|form|searchParams|params)$/i]",
            "message": "Do not cast form or search input with `as string`. Parse it with a zod schema via parseFormData from app/lib/validation.ts."
          },
          {
            "selector": "TSAsExpression[typeAnnotation.type='TSStringKeyword'] > CallExpression[callee.property.name='get'][callee.object.property.name=/^(formData|searchParams)$/]",
            "message": "Do not cast form or search input with `as string`. Parse it with a zod schema via parseFormData from app/lib/validation.ts."
          },
          // "Use the design tokens". A hex colour in a string or template. A
          // quoted hex inside a CSS attribute selector (stroke='#ccc') is not
          // a colour being set, so it is not matched.
          {
            "selector": "Literal[value=/(^|[^'\"\\w&-])#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b/]",
            "message": "Use a design token (e.g. text-muted-foreground), not a raw hex colour."
          },
          {
            "selector": "TemplateElement[value.raw=/(^|[^'\"\\w&-])#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b/]",
            "message": "Use a design token (e.g. text-muted-foreground), not a raw hex colour."
          },
          // "Never build a query by joining strings". sql.raw splices its
          // argument into the query unescaped, so it may only take one fixed
          // string: a string literal or a template with no ${}. Anything else
          // (a variable, a concatenation, an interpolated template, no
          // argument) is reported.
          {
            "selector": "CallExpression[callee.object.name=\"sql\"][callee.property.name=\"raw\"]:not([arguments.length=1][arguments.0.value=type(string)]):not([arguments.length=1][arguments.0.type=\"TemplateLiteral\"][arguments.0.expressions.length=0])",
            "message": "sql.raw only takes a fixed string. Pass dynamic values through the sql`...` template so they are parameterised."
          }
        ],
        // "Throw `Error`, never a string"
        "no-throw-literal": "error",
        // "Do not catch an error only to re-throw it unchanged"
        "no-useless-catch": "error",
        // "Prefer arrow functions for callbacks"
        "prefer-arrow-callback": "error",
        // "Return early rather than nesting" (the `else` after a `return`)
        "no-else-return": ["error", { "allowElseIf": false }],
        // "Default exports only for route modules" (route modules exempted
        // below; root config files such as vite.config.ts are outside the
        // lint scope)
        "no-restricted-exports": [
          "error",
          {
            "restrictDefaultExports": {
              "direct": true,
              "named": true,
              "defaultFrom": true,
              "namedFrom": true,
              "namespaceFrom": true
            }
          }
        ],
        // "Do not commit a skipped test": describe/it/test x skip/only/todo
        "no-restricted-properties": [
          "error",
          {
            "object": "describe",
            "property": "skip",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "describe",
            "property": "only",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "describe",
            "property": "todo",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "it",
            "property": "skip",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "it",
            "property": "only",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "it",
            "property": "todo",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "test",
            "property": "skip",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "test",
            "property": "only",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          },
          {
            "object": "test",
            "property": "todo",
            "message": "Do not commit a skipped, focused or placeholder test: fix it or delete it. Use skipIf only for a platform the test cannot run on."
          }
        ],
        // "Use `===`, never `==`"
        "eqeqeq": ["error", "always"],
        // "Use `const` unless you reassign"
        "prefer-const": "error",
        "no-var": "error",
        // "Do not write a type that the compiler can infer" (literal cases
        // only)
        "typescript/no-inferrable-types": "error",
        // "Prefer `interface` for object shapes, `type` for unions" and
        // "Component props are a `type`": one way to write a shape, `type`.
        "typescript/consistent-type-definitions": ["error", "type"],
        // "Do not nest more than three levels"
        "max-depth": ["error", 3],
        // "Imports are sorted: packages, then aliases, then relative". The
        // plugin's default groups are exactly that order; `oxlint --fix`
        // sorts them.
        "simple-import-sort/imports": "error"
      }
    },
    {
      // React Router loads a route module's component from its default
      // export.
      "files": ["app/routes/**/*.{ts,tsx}", "app/root.tsx", "app/routes.ts"],
      "rules": { "no-restricted-exports": "off" }
    },
    {
      // "Keep every file under 500 lines". Tests and the seed script are
      // exempt: they grow with the behaviour they cover.
      "files": [
        "app/**/*.{ts,tsx}",
        "scripts/**/*.{ts,tsx}",
        "request-logger/**/*.{ts,tsx}"
      ],
      "excludeFiles": ["**/*.test.{ts,tsx}", "scripts/seed.ts"],
      "rules": {
        "max-lines": [
          "error",
          { "max": 500, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      // No console.log in the app. scripts/ and request-logger/ are CLIs,
      // where printing is the output.
      "files": ["app/**/*.{ts,tsx}"],
      "rules": {
        // "No `console.log` left in a committed file"
        "no-console": ["error", { "allow": ["error", "warn"] }],
        // "Effects declare every value they read". To read a callback
        // without re-running the effect, wrap it in useEffectEvent rather
        // than disabling.
        "react/exhaustive-deps": "error"
      }
    },
    {
      "files": ["app/**/*.tsx"],
      "rules": {
        // Accessibility: "Every image has alt text", "Every input has a
        // label", "Do not set a positive tabIndex", "Use semantic elements".
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        // React, three rules only: "Every item in a list gets a stable key",
        // "Set rel=noopener noreferrer on every external link" and "Escape
        // anything a person typed before you render it as HTML". Each
        // dangerouslySetInnerHTML carries a disable saying why its HTML is
        // safe. For loading placeholders, use skeletonKeys from
        // ~/components/ui/skeleton.
        "react/no-array-index-key": "error",
        "react/jsx-no-target-blank": "error",
        "react/no-danger": "error"
      }
    }
  ]
}
